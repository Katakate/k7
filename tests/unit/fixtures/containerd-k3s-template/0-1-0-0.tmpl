# version = 3
{{ template "base" . }}


[plugins."io.containerd.snapshotter.v1.overlayfs"]
  mount_options = ["nodev", "nosuid"]

[plugins."io.containerd.cri.v1.runtime".containerd.runtimes.kata-qemu]
  runtime_type  = "io.containerd.kata.v2"
  privileged_without_host_devices = true
  snapshotter   = "overlayfs"
  pod_annotations = ["io.katacontainers.config.hypervisor.default_memory", "io.katacontainers.config.hypervisor.rx_rate_limiter_max_rate", "io.katacontainers.config.hypervisor.tx_rate_limiter_max_rate"]
  [plugins."io.containerd.cri.v1.runtime".containerd.runtimes.kata-qemu.options]
    BinaryName  = "/usr/local/bin/containerd-shim-kata-v2"
    ConfigPath  = "/opt/kata/share/defaults/kata-containers/configuration-qemu.toml"


