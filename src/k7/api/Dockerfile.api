# Base images pinned by digest (Dependabot bumps them); tags are for humans.
# uv pin matches UV_VERSION in .github/workflows.
FROM ghcr.io/astral-sh/uv:0.12.23@sha256:61d393e44e249f2e4b526b6c7ddcecce245946826e608e11c93ad4f5bba55b21 AS uv

# Same interpreter in both stages so the venv's Python symlink stays valid.
# 3.12.15-slim-trixie is the current patched Debian 13 slim.
FROM python:3.15.0-slim-trixie@sha256:f5b92f2a669a4c347044f29367f31983280b648250ca94dea66f98c53bc87e58 AS build
COPY --from=uv /uv /uvx /bin/

# Repo .python-version pins 3.10 for CI. This image stays on the base
# interpreter; do not let uv download another one.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    UV_PYTHON=/usr/local/bin/python3 \
    UV_NO_DEV=1

WORKDIR /app

# crictl (pinned): k7d VM ops (pause/resume/fork) resolve a pod to its CRI
# sandbox id via `crictl pods` against the node's containerd socket, which
# the k7-agent DaemonSet hostPath-mounts. The node's own
# /usr/local/bin/crictl is a k3s symlink and can't be mounted usefully.
# v1.36.0 is the newest cri-tools release on the K3s v1.36 line
# (playbook k3s_version v1.36.5+k3s1).
ARG CRICTL_VERSION=v1.36.0
ARG CRICTL_SHA256=83855e114566a8a8c44c548d515670f51de3a5e1da8b2effb59870e2f10c25a3
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL -o /tmp/crictl.tar.gz \
      "https://github.com/kubernetes-sigs/cri-tools/releases/download/${CRICTL_VERSION}/crictl-${CRICTL_VERSION}-linux-amd64.tar.gz" \
    && echo "${CRICTL_SHA256}  /tmp/crictl.tar.gz" | sha256sum -c - \
    && tar -C /usr/local/bin -xzf /tmp/crictl.tar.gz crictl \
    && rm /tmp/crictl.tar.gz \
    && rm -rf /var/lib/apt/lists/*

# Locked dependencies, then the project. --locked refuses a stale uv.lock.
# --no-editable puts the package in the venv so the runtime stage does not
# need the source tree. Context is the repo root (release workflow,
# `make api-build-local`, and `k7 install --api-image local`).
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=/app/uv.lock \
    --mount=type=bind,source=pyproject.toml,target=/app/pyproject.toml \
    uv sync --locked --no-dev --no-install-project --no-editable

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable

FROM python:3.15.0-slim-trixie@sha256:f5b92f2a669a4c347044f29367f31983280b648250ca94dea66f98c53bc87e58 AS runtime
ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/bin/crictl /usr/local/bin/crictl
COPY --from=build /app/.venv /app/.venv

RUN useradd -m -u 1000 k7user && chown -R k7user:k7user /app
USER k7user

EXPOSE 8000
CMD ["uvicorn", "k7.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
